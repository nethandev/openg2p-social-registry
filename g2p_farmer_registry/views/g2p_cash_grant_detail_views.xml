<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- 3. Tree view for Cash Grant Details -->
    <record id="g2p_farmer_registry.view_cash_grant_detail_tree" model="ir.ui.view">
        <field name="name">g2p.cash.grant.detail.tree</field>
        <field name="model">g2p.cash.grant.detail</field>
        <field name="arch" type="xml">
            <tree>
                <field name="partner_id"/>
                <field name="season_id"/>
                <field name="subsidy_type"/>
                <field name="district_id"/>
                <field name="asc_id"/>
                <field name="plr_number"/>
                <field name="land_extent" sum="Total Land Extent (HA)"/>
                <field name="bank_id" string="Bank"/>
                <field name="branch_id" string="Branch"/>
                <field name="account_detail"/>
                <field name="slip_number"/>
                <field name="amount_quantity"/>
                <field name="status_id"/>
                <field name="cultivation_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- 1. Form view for Land Details -->
    <record id="g2p_farmer_registry.view_cash_grant_detail_form" model="ir.ui.view">
        <field name="name">g2p.cash.grant.detail.form</field>
        <field name="model">g2p.cash.grant.detail</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="season_id"/>
                            <field name="subsidy_type"/>
                            <field name="district_id"/>
                            <field name="asc_id"/>
                            <field name="plr_number"/>
                            <field name="land_id"/>
                            <field name="irrigation"/>
                            <field name="land_extent"/>
                            <field name="bank_id" string="Bank Name"/>
                            <field name="branch_id" string="Branch Name"/>
                            <field name="account_detail"/>
                            <field name="slip_number"/>
                            <field name="amount_quantity"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="nic_number"/>
                            <field name="address"/>
                            <!--                            <field name="phone_number"/>-->
                            <field name="gn_division_id"/>
<!--                            <field name="gn_division"/>-->
                            <field name="old_dos"/>
                            <field name="trance_date"/>
                            <field name="reject_date"/>
                            <field name="status_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Cash Grant List Action -->
    <record id="action_cash_grant_list" model="ir.actions.act_window">
        <field name="name">Cash Grants</field>
        <field name="res_model">g2p.cash.grant.detail</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="g2p_farmer_registry.view_cash_grant_detail_tree"/>  <!-- add this -->
        <field name="domain">[]</field>
    </record>

    <!-- Grant Status -->
    <record id="view_status_grant_tree" model="ir.ui.view">
        <field name="name">status.grant.tree</field>
        <field name="model">status.grant</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name" required="1"/>
                <field name="code" required="1"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Cash Grants menu -->
    <menuitem
            id="menu_cash_grants"
            name="Cash Grant Details"
            action="g2p_farmer_registry.action_cash_grant_list"
            web_icon="g2p_farmer_registry,static/description/grant.png"
            sequence="4"
    />

    <!-- 3. Grant Status -->
    <record id="action_status_grant" model="ir.actions.act_window">
        <field name="name">Grant Status</field>
        <field name="res_model">status.grant</field>
        <field name="view_mode">tree</field>
        <field name="context">{'tree_view_ref': 'g2p_farmer_registry.view_status_grant_tree'}</field>
    </record>

    <menuitem
            id="menu_status_grant"
            name="Cash Grant Details Status"
            parent="menu_status_management"
            action="action_status_grant"
            sequence="30"
    />

</odoo>