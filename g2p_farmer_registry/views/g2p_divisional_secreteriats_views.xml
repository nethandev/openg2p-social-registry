<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_g2p_divisional_secretariat_tree" model="ir.ui.view">
        <field name="name">g2p.divisional.secretariat.tree</field>
        <field name="model">g2p.divisional.secretariat</field>
        <field name="arch" type="xml">
            <tree>
<!--                <field name="ds_id"/>-->
                <field name="name"/>
                <field name="district_id"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_g2p_divisional_secretariat_form" model="ir.ui.view">
        <field name="name">g2p.divisional.secretariat.form</field>
        <field name="model">g2p.divisional.secretariat</field>
        <field name="arch" type="xml">
            <form string="Divisional Secretariat">
                <sheet>
                    <group>
                        <group>
<!--                            <field name="ds_id" required="1"/>-->
                            <field name="name" required="1"/>
                        </group>
                        <group>
                            <field name="district_id" required="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_g2p_divisional_secretariat" model="ir.actions.act_window">
        <field name="name">Divisional Secretariats</field>
        <field name="res_model">g2p.divisional.secretariat</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Divisional Secretariat!
            </p>
        </field>
    </record>

    <!-- Menus under Configuration -->
    <menuitem
        id="menu_g2p_divisional_secretariat_root"
        name="Divisional Secretariats"
        parent="g2p_registry_base.g2p_configuration_menu_root"
        action="action_g2p_divisional_secretariat"
        sequence="3"
    />

</odoo>