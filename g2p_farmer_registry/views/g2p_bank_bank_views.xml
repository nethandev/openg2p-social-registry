<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Bank Tree -->
    <record id="view_res_bank_tree" model="ir.ui.view">
        <field name="name">res.bank.tree</field>
        <field name="model">res.bank</field>
        <field name="inherit_id" ref="base.view_res_bank_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="replace">
                <tree>
                    <field name="name"/>
                    <field name="bic"/>
                </tree>
            </xpath>
        </field>
    </record>

    <!-- Bank Form -->
    <record id="view_res_bank_form" model="ir.ui.view">
        <field name="name">res.bank.form</field>
        <field name="model">res.bank</field>
        <field name="inherit_id" ref="base.view_res_bank_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="replace">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="bic"/>
                    </group>
                </sheet>
            </xpath>

        </field>
    </record>

    <!-- Bank Action -->
<!--    <record id="action_bank" model="ir.actions.act_window">-->
<!--        <field name="name">Banks</field>-->
<!--        <field name="res_model">g2p.bank.bank</field>-->
<!--        <field name="view_mode">tree,form</field>-->
<!--    </record>-->

    <!-- Bank Menu -->
    <menuitem id="menu_bank"
              name="Bank"
              parent="g2p_registry_base.g2p_configuration_menu_root"
              action="base.action_res_bank_form"
              sequence="8"/>

</odoo>
