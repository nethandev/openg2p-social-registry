<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Sinhala -->
    <record id="lang_si_lk" model="res.lang">
        <field name="name">Sinhala (Sri Lanka)</field>
        <field name="code">si_LK</field>
        <field name="iso_code">si</field>
        <field name="url_code">si</field>
        <field name="direction">ltr</field>
        <field name="date_format">%Y-%m-%d</field>
        <field name="time_format">%H:%M:%S</field>
        <field name="grouping">[3,0]</field>
        <field name="decimal_point">.</field>
        <field name="thousands_sep">,</field>
        <field name="week_start">1</field>
        <field name="active">True</field>
    </record>

    <!-- Tamil -->
    <record id="lang_ta_lk" model="res.lang">
        <field name="name">Tamil (Sri Lanka)</field>
        <field name="code">ta_IN</field>
        <field name="iso_code">ta</field>
        <field name="url_code">ta</field>
        <field name="direction">ltr</field>
        <field name="date_format">%Y-%m-%d</field>
        <field name="time_format">%H:%M:%S</field>
        <field name="grouping">[3,0]</field>
        <field name="decimal_point">.</field>
        <field name="thousands_sep">,</field>
        <field name="week_start">1</field>
        <field name="active">True</field>
    </record>

</odoo>
